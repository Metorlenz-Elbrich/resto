# Mot de passe pour accéder à l'espace admin (/admin) — choisis-en un solide.
# En local : copie ce fichier en ".env.local" et remplace la valeur.
# Sur Railway : définis cette variable dans l'onglet "Variables" du service.
ADMIN_PASSWORD=change-moi

# Dossier où sont stockées la base SQLite et les photos uploadées.
# En local, "./data" convient. Sur Railway, fais pointer cette variable
# vers le point de montage de ton volume persistant (ex: /data).
DATA_DIR=./data
